DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/survival
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# LLM keys live ONLY here (server). UI does not collect API keys.
# Provider is chosen per user in the app Settings; keys are picked by provider:
#   openai     -> OPENAI_API_KEY
#   openrouter -> OPENROUTER_API_KEY
#   gemini     -> GEMINI_API_KEY
OPENAI_API_KEY=
# Used for OpenAI provider; for OpenRouter use an OpenRouter slug (e.g. openai/gpt-oss-120b:free).
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional: cap reasoning channel for gpt-oss / o-series etc. (stops OpenRouter default ~16k reasoning → 402).
# Set to 0 to disable sending reasoning.* . Set to e.g. 512–1024 on very low free credits.
# OPENROUTER_REASONING_MAX_TOKENS=
GEMINI_API_KEY=
# Comma-separated allowed web origins. localhost / 127.0.0.1 pairs are expanded automatically.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional (only if you add other encrypted user secrets later)
CREDENTIALS_ENCRYPTION_KEY=
# Optional: raise if chat still times out (slow network / many tool rounds)
# LLM_CONNECT_TIMEOUT_SECONDS=45
# LLM_READ_TIMEOUT_SECONDS=300
# Optional: cap each assistant completion (OpenRouter uses this for max_completion_tokens; try 1024–2048 on free credits)
# LLM_MAX_OUTPUT_TOKENS=2048
# Optional: LLM tool-loop JSON traces (each /chat run → {dir}/{user_id}/{run_id}/flow_layer01.json, …)
# Relative paths resolve from apps/api. Example: var/llm_flow_trace
# LLM_FLOW_TRACE_DIR=
# LLM_FLOW_TRACE_MAX_CHARS=6000
