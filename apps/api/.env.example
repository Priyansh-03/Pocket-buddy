DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/survival
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# LLM keys live ONLY here (server). UI does not collect API keys.
# Provider is chosen per user in the app Settings; keys are picked by provider:
#   openai     -> OPENAI_API_KEY, or if empty OUTSPARK_OPENAI_STAGING_API_KEY
#   openrouter -> OPENROUTER_API_KEY
#   gemini     -> GEMINI_API_KEY
OPENAI_API_KEY=
OUTSPARK_OPENAI_STAGING_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CORS_ORIGIN=http://localhost:5173
# Optional (only if you add other encrypted user secrets later)
CREDENTIALS_ENCRYPTION_KEY=
# Optional: raise if chat still times out (slow network / many tool rounds)
# LLM_CONNECT_TIMEOUT_SECONDS=45
# LLM_READ_TIMEOUT_SECONDS=300
